# Enviroment File:
# Remove "example" from file name to make the file active -> ".env"
# Leave no spaces in config: example="This is Correct"

# System Name used for Emails and website titles
SYSTEM_NAME="Krupam's" # Mesonet System

# Bootstrap. First Admin Account setup. MAKE SURE TO SET TO FALSE AFTER
BOOTSTRAP_REGISTRATION=True
ADMIN_EMAIL_PUBLIC="krupam@krupamlab.com"

# Weather Underground Base Url:
WU_BASE_URL="https://preview.wunderground.com/dashboard/pws/"

# Where you host the website
WEBSITE_URL="https://sbb.krupamlab.com"

# FastAPI:
FASTAPI_PORT=8000

# Scrape Intervals:
STATUS_SCRAPER_INTERVAL_SECONDS=900
WEATHER_SCRAPER_INTERVAL_SECONDS=300

# Security:
SECRET_KEY="ABC1234"
POSTGRES_PASSWORD="test"
SCRAPER_API_KEY="test"
API_KEY="test"
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM="HS256"
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Database:
API_BASE="http://web:8000"
API_POST_URL="/status/stations"
API_WEATHER_POST="/weather/stations"
POSTGRES_PASSWORD=test
POSTGRES_DB=mesonet
POSTGRES_USER=mesonet
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backup Retention:
BACKUP_KEEP_YEAR=0
BACKUP_KEEP_MONTHS=1
BACKUP_KEEP_WEEKS=0
BACKUP_KEEP_DAYS=14
BACKUP_SERVICE="db_backup"

# Email Setup
SERVER="smtp.gmail.com"
PORT=587
USERNAME="example@gmail.com"
PASSWORD="password"
FROM_EMAIL="Krupam's Mesonet Notifications <youremail@gmail.com>"

# Time Infomation:
TIMEZONE="America/New_York"
TIME_ZONE_NAME="EST"
PYTZ_TIMEZONE="America/New_York"

# Scraping Retry Logic
CONSECUTIVE_OFFLINE=3
MAX_RETRIES=5
BACKOFF_FACTOR=3

# Monthly Email Time/Day
MONTHLY_EMAIL_DAY=1
MONTHLY_EMAIL_HOUR=8
ERROR_EMAIL_COOLDOWN=60
# ^ = MINS
MONTHLY_WEATHER_URL="/graph/analysis/month"

# Reminders
DAYS_BEFORE_REMIND=7

# Weather Stations:
STATIONS_JSON='{"KNJBERKE13":"Island Beach State Park Bathhouse #1","KNJWARET3":"Sedge Island","KNJMANAH111":"Stafford Municipal Complex","KNJMANAH7":"MATES/Stafford","KNJBAYHE18":"Bayhead Fire Company #1","KNJLONGB89":"LBT Marine Field Station","KNJLONGB21":"LBI Foundation","KNJBEACH64":"Beachwood Yacht Club","KNJOCEAN178":"Ocean Gate Yacht Club","KNJSEASI44":"Seaside Park Yacht Club","Ecocenter":"Ecocenter"}'

# Developing Mode:
DEVELOP=False

# Station Status History Query Default Values:
DEFAULT_HISTORY=20
LIMIT_HISTORY=1000

# Temperature Widget:
# C
M_TEMP_MAX=40
M_TEMP_MIN=0
# F
TEMP_MAX=120
TEMP_MIN=-10

# Pressure Widget:
PRESSURE_MIN=29.12
PRESSURE_MID=29.92
PRESSURE_MAX=30.72
ANGLE_MAX=120
ANGLE_MIN=-120